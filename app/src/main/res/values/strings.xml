    <!-- Onboarding -->
    <string name="onboarding_mode_title">Méthode</string>
    <string name="onboarding_mode_notifications_body">Fonctionne avec un compte Instagram personnel. Mosaic lit les notifications Instagram de cette personne, à partir de maintenant. Aucun identifiant Instagram n\'est demandé, aucun serveur n\'est utilisé. L\'historique antérieur n\'est pas récupérable.</string>
    <string name="onboarding_mode_api_body">Réservé aux comptes professionnels (Business/Creator) éligibles à l\'API Meta. Nécessite un jeton d\'accès longue durée que vous générez depuis votre propre application Meta.</string>

    <string name="onboarding_permission_title">Accès aux notifications</string>
    <string name="onboarding_permission_body">Android va demander l\'accès aux notifications. Cet accès est nécessaire parce qu\'il n\'existe aucun autre moyen officiel de lire les messages d\'un compte Instagram personnel. Mosaic ne conserve que les notifications de la personne choisie et ignore tout le reste.</string>

    <string name="onboarding_token_title">Jeton d\'accès</string>
    <string name="onboarding_token_body">Collez un jeton d\'accès longue durée obtenu depuis votre propre application Meta. Mosaic n\'intègre aucun secret Meta et ne demande jamais votre mot de passe Instagram. Le jeton est chiffré par le Keystore Android.</string>
    <string name="onboarding_token_label">Jeton d\'accès</string>

    <string name="onboarding_target_title">Personne suivie</string>
    <string name="onboarding_target_body_notifications">Sélectionnez la conversation dans la liste ci-dessous dès qu\'une notification arrive, ou saisissez le nom affiché manuellement.</string>
    <string name="onboarding_target_body_api">Indiquez le nom d\'utilisateur Instagram de la personne.</string>
    <string name="onboarding_target_name">Nom affiché</string>
    <string name="onboarding_target_handle">Nom d\'utilisateur (facultatif)</string>

    <string name="onboarding_alias_title">Alias local</string>
    <string name="onboarding_alias_body">Ce nom remplace l\'identité réelle partout dans l\'application. Il n\'est appliqué que localement et ne change rien sur Instagram.</string>

    <string name="onboarding_done_title">Terminé</string>
    <string name="onboarding_done_body">Le coffre est prêt. Il se verrouille à chaque fermeture.</string>
