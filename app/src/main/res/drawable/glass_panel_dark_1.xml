<?xml version="1.0" encoding="utf-8"?>
<!-- Generated glass panel, opacity bucket 1. AppWidgets cannot blur what is
     behind them, so depth comes from a vertical gradient plus a fine rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#473D4756"
                android:centerColor="#5C18202B"
                android:endColor="#730A0F16" />
            <stroke android:width="1dp" android:color="#3FA8C4D8" />
        </shape>
    </item>
    <!-- Crown highlight: the bright edge where a glass panel catches light. -->
    <item android:height="2dp" android:gravity="top" android:left="18dp" android:right="18dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#53FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
