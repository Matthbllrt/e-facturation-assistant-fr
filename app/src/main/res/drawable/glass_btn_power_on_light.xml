<?xml version="1.0" encoding="utf-8"?>
<!-- Power on, light -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#520B7185" />
        <stroke android:width="1dp" android:color="#FF0B7185" />
    </shape>
    </item>
    <item>
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#380B7185" />
        <stroke android:width="1dp" android:color="#E60B7185" />
    </shape>
    </item>
</selector>
