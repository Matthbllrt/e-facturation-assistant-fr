<?xml version="1.0" encoding="utf-8"?>
<!-- Power on: cyan border and glow -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#525AD7F0" />
        <stroke android:width="1dp" android:color="#FF5AD7F0" />
    </shape>
    </item>
    <item>
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#385AD7F0" />
        <stroke android:width="1dp" android:color="#CC5AD7F0" />
    </shape>
    </item>
</selector>
