<?xml version="1.0" encoding="utf-8"?>
<!-- Active control, cyan accent -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#4A5AD7F0" />
        <stroke android:width="1dp" android:color="#CC5AD7F0" />
    </shape>
    </item>
    <item>
    <shape android:shape="rectangle">
        <corners android:radius="22dp" />
        <solid android:color="#2E5AD7F0" />
        <stroke android:width="1dp" android:color="#995AD7F0" />
    </shape>
    </item>
</selector>
