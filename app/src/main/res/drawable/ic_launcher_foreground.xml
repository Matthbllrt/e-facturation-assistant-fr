<?xml version="1.0" encoding="utf-8"?>
<!--
  RadarDeal mark: three concentric radar rings, a sweeping wedge and a solid centre blip.
  Drawn inside the 108dp adaptive-icon canvas; all artwork stays inside the inner 66dp
  safe zone (viewport 27..81) so that no detail is clipped by any launcher mask shape.
  Every ring is built from two half-arcs — a single 360° arc renders inconsistently
  across VectorDrawable implementations.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Sweep wedge: brightest element, anchored at the centre and opening up-right. -->
    <path android:pathData="M54,54 L54,26 A28,28 0 0,1 78.24,40 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="54"
                android:endX="76"
                android:endY="30">
                <item android:offset="0" android:color="#0000C7A5" />
                <item android:offset="1" android:color="#5900C7A5" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Outer ring -->
    <path
        android:strokeColor="#3D00C7A5"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M26,54 A28,28 0 0,1 82,54 A28,28 0 0,1 26,54 Z" />

    <!-- Middle ring -->
    <path
        android:strokeColor="#7A00C7A5"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M36,54 A18,18 0 0,1 72,54 A18,18 0 0,1 36,54 Z" />

    <!-- Inner ring -->
    <path
        android:strokeColor="#C400C7A5"
        android:strokeWidth="3.5"
        android:fillColor="#00000000"
        android:pathData="M45,54 A9,9 0 0,1 63,54 A9,9 0 0,1 45,54 Z" />

    <!-- Sweep arm -->
    <path
        android:strokeColor="#FF00C7A5"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M54,54 L74.5,33.5" />

    <!-- Centre blip -->
    <path
        android:fillColor="#FFF5F8FB"
        android:pathData="M49.5,54 A4.5,4.5 0 0,1 58.5,54 A4.5,4.5 0 0,1 49.5,54 Z" />

    <!-- Detected target blip -->
    <path
        android:fillColor="#FF00C7A5"
        android:pathData="M64,67 A5,5 0 0,1 74,67 A5,5 0 0,1 64,67 Z" />
</vector>
