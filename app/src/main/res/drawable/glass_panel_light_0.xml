<?xml version="1.0" encoding="utf-8"?>
<!-- Generated glass panel, opacity bucket 0. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="30dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#4CFFFFFF"
                android:centerColor="#43F2F6FA"
                android:endColor="#37DCE5EE" />
            <stroke android:width="1dp" android:color="#2EFFFFFF" />
        </shape>
    </item>
    <item android:height="2dp" android:gravity="top" android:left="18dp" android:right="18dp" android:top="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="2dp" />
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00FFFFFF"
                android:centerColor="#49FFFFFF"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>
</layer-list>
