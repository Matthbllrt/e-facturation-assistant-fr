<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Least privilege. Notably absent, because nothing here needs them:
      contacts, external storage, location, microphone, camera, SMS,
      READ_PHONE_STATE, and any "get accounts" permission.
    -->

    <!-- Mode A only: the Instagram Graph API. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Only needed if the user opts in to the neutral, content-free notification.
      The default policy posts nothing at all, so this is never requested unless
      that setting is turned on.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Biometric unlock. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      Lets Mosaic tell "Instagram is not installed" apart from "the intent
      failed", so the fallback button can say something true.
    -->
    <queries>
        <package android:name="com.instagram.android" />
        <package android:name="com.instagram.lite" />
    </queries>

    <application
        android:name=".MosaicApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mosaic"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:excludeFromRecents="false"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Mosaic"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Mode B capture. Bound by the system only after the user grants
          notification access in system settings; there is no way for the app to
          grant it to itself.
        -->
        <service
            android:name=".sync.notification.MosaicNotificationListener"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations" />
        </service>

        <!--
          WorkManager's default initializer is disabled and replaced by nothing:
          Mosaic initialises WorkManager on demand through the standard
          on-demand path, which keeps the cold-start surface minimal.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
